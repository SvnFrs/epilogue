# Copy to .env for docker compose. NEVER commit the real .env.
POSTGRES_USER=epilogue
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=epilogue

# The single local owner (seeded by the migrate one-shot). The web tier sends this id.
OWNER_ID=00000000-0000-4000-8000-000000000001

# Shared secret gating the trusted owner header (eng-review Issue 1). Generate a long random
# value: `openssl rand -hex 32`. Only the web tier holds it.
OWNER_SECRET=change-me-32-bytes-hex

# Public origin allowed by CORS + your tailnet host for Caddy TLS.
WEB_ORIGIN=https://epilogue.your-tailnet.ts.net
EPILOGUE_HOST=epilogue.your-tailnet.ts.net
